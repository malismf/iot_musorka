# Настройки сервера BinSense.
# Скопируйте в .env (или выполните ./infra/scripts/init-env.sh) и заполните.
# Файл .env содержит пароли и в git не попадает.

# --- Домен и адреса ----------------------------------------------------------
# Домен, на который смотрит A-запись сервера. Caddy сам получит сертификат.
# Для локального запуска: DOMAIN=localhost и PUBLIC_URL=https://localhost
DOMAIN=bins.example.com
PUBLIC_URL=https://bins.example.com
TZ=Europe/Moscow

# Адрес брокера, который прошивается в устройства (обычно тот же домен).
# Локальный стенд: IP ноутбука в сети, куда подключается плата, — не localhost
# (см. docs/LOCAL_TEST.md)
MQTT_PUBLIC_HOST=bins.example.com
MQTT_PUBLIC_PORT=1883

# --- Секреты (обязательно поменять) -----------------------------------------
POSTGRES_PASSWORD=change-me-postgres
JWT_SECRET=change-me-very-long-random-string
MQTT_ADMIN_USER=binsense-admin
MQTT_ADMIN_PASSWORD=change-me-mqtt
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_DB_PASSWORD=change-me-grafana-db

# --- Первый администратор системы -------------------------------------------
ADMIN_EMAIL=admin@bins.example.com
ADMIN_PASSWORD=change-me-admin
# Роль, которую получают пользователи при самостоятельной регистрации
DEFAULT_ROLE=dispatcher
ALLOW_REGISTRATION=true

# --- Telegram-бот (можно оставить пустым — тогда уведомлений не будет) -------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Карта -------------------------------------------------------------------
MAP_CENTER=55.7558,37.6173
MAP_ZOOM=12

# --- Настройки устройств по умолчанию ---------------------------------------
DEFAULT_INTERVAL_S=900
DEFAULT_HEARTBEAT_S=7200
DEFAULT_FULL_INTERVAL_S=300
DEFAULT_NIGHT_INTERVAL_S=1800
DEFAULT_NIGHT_START=23
DEFAULT_NIGHT_END=7
DEFAULT_FULL_PCT=80
DEFAULT_DELTA_PCT=3
DEFAULT_SAMPLES=7
DEFAULT_TZ=MSK-3

# --- Пороги уведомлений ------------------------------------------------------
OFFLINE_FACTOR=1.5
URGENT_FILL=95
URGENT_DELAY_MIN=120
COLLECTED_LOW_PCT=15
COLLECTED_HIGH_PCT=50

# --- Хранение ----------------------------------------------------------------
TELEMETRY_RETENTION_DAYS=365
METRICS_RETENTION_DAYS=30
LOG_LEVEL=INFO
