    {
      "id": 5,
      "type": "stat",
      "title": "Потеряно сообщений, %",
      "description": "Считается по разрывам счётчика seq в телеметрии",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "binsense-pg"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "binsense-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(100.0 * COALESCE(sum(lost), 0) /\n                 NULLIF(count(*) + COALESCE(sum(lost), 0), 0), 2) AS \"потери\"\n      FROM device_metrics WHERE $__timeFilter(ts)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
