    {
      "id": 7,
      "type": "timeseries",
      "title": "Задержка доставки телеметрии",
      "description": "Разница между временем измерения на устройстве и временем приёма сервером",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "binsense-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "binsense-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval),\n           percentile_cont(0.5) WITHIN GROUP (ORDER BY latency_ms) AS \"медиана\",\n           percentile_cont(0.95) WITHIN GROUP (ORDER BY latency_ms) AS \"95-й процентиль\"\n      FROM device_metrics\n     WHERE $__timeFilter(ts) AND latency_ms IS NOT NULL\n     GROUP BY 1\n     ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Время подключения устройства",
      "description": "Сколько заняло последнее подключение к Wi-Fi и брокеру: растёт — связь ухудшается",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "binsense-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "binsense-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval),\n           avg(wifi_ms) AS \"подключение Wi-Fi\",\n           avg(mqtt_ms) AS \"подключение MQTT\"\n      FROM device_metrics\n     WHERE $__timeFilter(ts)\n     GROUP BY 1\n     ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Уровень сигнала Wi-Fi",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "binsense-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "binsense-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval),\n           COALESCE(d.name, m.device_id) AS metric,\n           avg(m.rssi) AS \"rssi\"\n      FROM device_metrics m\n      LEFT JOIN devices d ON d.id = m.device_id\n     WHERE $__timeFilter(m.ts) AND m.rssi IS NOT NULL\n     GROUP BY 1, 2\n     ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "dBm"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Время ответа API",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "binsense-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "binsense-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval),\n           percentile_cont(0.5) WITHIN GROUP (ORDER BY duration_ms) AS \"медиана\",\n           percentile_cont(0.95) WITHIN GROUP (ORDER BY duration_ms) AS \"95-й процентиль\"\n      FROM api_requests\n     WHERE $__timeFilter(ts)\n     GROUP BY 1\n     ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Запросы к API по кодам ответа",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "binsense-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "binsense-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval),\n           status::text AS metric,\n           count(*) AS \"запросов\"\n      FROM api_requests\n     WHERE $__timeFilter(ts)\n     GROUP BY 1, 2\n     ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "type": "table",
      "title": "Простой устройств (нет связи)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "binsense-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "binsense-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(d.name, e.device_id) AS \"контейнер\",\n           count(*) AS \"случаев\",\n           round(sum(EXTRACT(EPOCH FROM (COALESCE(e.resolved_at, now()) - e.created_at)))\n                 / 3600.0, 1) AS \"часов без связи\"\n      FROM events e\n      JOIN devices d ON d.id = e.device_id\n     WHERE e.type = 'offline' AND $__timeFilter(e.created_at)\n     GROUP BY 1\n     ORDER BY 3 DESC\n     LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "type": "table",
      "title": "Причины перезагрузок",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "binsense-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "binsense-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT reset_reason AS \"причина\", count(*) AS \"раз\"\n      FROM device_metrics\n     WHERE reset_reason IS NOT NULL AND $__timeFilter(ts)\n     GROUP BY 1\n     ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 14,
      "type": "table",
      "title": "Последние сбои датчиков",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "binsense-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "binsense-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.created_at AS \"время\",\n           COALESCE(d.name, e.device_id) AS \"контейнер\",\n           e.message AS \"сообщение\"\n      FROM events e\n      LEFT JOIN devices d ON d.id = e.device_id\n     WHERE e.type = 'sensor_error' AND $__timeFilter(e.created_at)\n     ORDER BY e.created_at DESC\n     LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 15,
      "type": "table",
      "title": "Устройства: прошивка и настройки",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "binsense-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "binsense-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT d.id AS \"устройство\", d.name AS \"название\", d.fw AS \"прошивка\",\n           c.version AS \"версия настроек\", c.applied_version AS \"применено\",\n           d.last_seen AS \"последние данные\"\n      FROM devices d\n      LEFT JOIN device_config c ON c.device_id = d.id\n     WHERE d.status = 'active'\n     ORDER BY d.last_seen DESC NULLS LAST"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    }
  ]
