    {
      "id": 3,
      "type": "stat",
      "title": "Доступность, %",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "binsense-pg"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "binsense-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE online) / NULLIF(count(*), 0), 1)\n             AS \"доступность\"\n      FROM devices WHERE status = 'active'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent"
        },
        "overrides": []
      },
