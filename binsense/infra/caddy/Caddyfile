# Caddy: HTTPS, статика веб-приложения и проксирование API/Grafana.
#
# DOMAIN=bins.example.com  — Caddy сам получит сертификат Let's Encrypt.
# DOMAIN=localhost         — локальный самоподписанный сертификат.
# DOMAIN=:80               — без HTTPS (например, во внутренней сети).

{$DOMAIN:localhost} {
	encode zstd gzip

	# Grafana (мониторинг для разработчиков) — префикс не срезаем,
	# он нужен самой Grafana при GF_SERVER_SERVE_FROM_SUB_PATH=true
	handle /grafana* {
		reverse_proxy grafana:3000
	}

	# REST API и WebSocket
	handle /api/* {
		reverse_proxy api:8000
	}

	# Собранное веб-приложение (SPA): неизвестные пути отдаём index.html
	handle {
		root * /srv
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
